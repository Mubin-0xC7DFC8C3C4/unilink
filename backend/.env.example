# UniLink backend — environment variables (copy the values into your
# shell / system environment; Spring Boot does NOT read this file).
# Anything marked CHANGE_ME must be replaced before first run; the
# packaged configuration fails fast when a secret is left unset.

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/unilink_dev?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
DB_USER=unilink_app
DB_PASSWORD=CHANGE_ME
DB_MIGRATION_USER=unilink_mig
DB_MIGRATION_PASSWORD=CHANGE_ME

# --- Security ---
# Long random string; encrypts GitHub tokens and admin TOTP secrets.
ENCRYPTION_KEY=CHANGE_ME

# --- First platform admin (created once, only when no admin exists) ---
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME

# --- App ---
APP_BASE_URL=http://localhost:8080
# dev seeds demo accounts/data (see README §12). Leave unset otherwise.
SPRING_PROFILES_ACTIVE=dev

# --- GitHub OAuth (optional; Workspace shows "not configured" without) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/workspace/github/callback
FRONTEND_BASE_URL=http://localhost:5173

# --- Providers (dev defaults need nothing) ---
SMS_PROVIDER=log
MAIL_FROM=noreply@unilink.dev
SMTP_HOST=localhost
SMTP_PORT=1025
# Only used when MAIL_PROVIDER=smtp. For Gmail: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587, SMTP_USERNAME=<your gmail>, SMTP_PASSWORD=<App Password>,
# SMTP_STARTTLS=true.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage-dev
OCR_PROVIDER=tesseract
TRUSTED_PROXIES=127.0.0.1,::1
