# UniLink production environment — copy to .env.production (gitignored) and
# fill in real values. NEVER commit the filled file. Every value marked
# REQUIRED is enforced by the prod Spring profile (the app refuses to start
# without it).

# --- Database (REQUIRED) ---
DB_NAME=unilink
DB_USER=unilink_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Flyway runs as this user; root is the default in the compose stack.
DB_MIGRATION_USER=root
DB_MIGRATION_PASSWORD=

# --- Application secrets (REQUIRED) ---
# Long random string; encrypts stored OAuth tokens at rest. Rotating it
# invalidates previously stored GitHub connections.
ENCRYPTION_KEY=
# First platform admin, created on first boot only.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Public origin (REQUIRED) ---
# The exact public origin of the app, e.g. https://unilink.example.edu
APP_BASE_URL=

# --- GitHub OAuth (optional; Workspace shows "not configured" without it) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Mail / SMS (optional in code, required for real OTP/reset delivery) ---
SMTP_HOST=
SMTP_PORT=587
MAIL_FROM=noreply@unilink.dev
SMS_PROVIDER=log

# --- Reverse proxy ---
# Only the listed direct peers may supply X-Forwarded-For. The bundled
# frontend nginx talks to the backend over the compose network; extend this
# only for a real external load balancer.
TRUSTED_PROXIES=127.0.0.1,::1
