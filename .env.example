# UniLink environment variables — copy to .env for local runs. NEVER commit real secrets.
# --- Database (dev defaults match the local MySQL users; change for any shared host) ---
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3306/unilink_dev?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
DB_USER=unilink_app
DB_PASSWORD=app_dev_pass
DB_MIGRATION_USER=unilink_mig
DB_MIGRATION_PASSWORD=mig_dev_pass
APP_BASE_URL=http://localhost:8080
SESSION_COOKIE_DOMAIN=
# --- Storage ---
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage-dev
S3_ENDPOINT=
S3_BUCKET_PRIVATE=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# --- Mail / SMS / OCR (dev uses logging adapters + Tesseract binary; prod needs real credentials) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@unilink.dev
SMS_PROVIDER=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=UniLink
OCR_PROVIDER=tesseract
OCR_DATA_PATH=
# --- Security ---
TOTP_ISSUER=UniLink
ENCRYPTION_KEY=change-me-to-a-long-random-value
INITIAL_ADMIN_EMAIL=admin@unilink.dev
INITIAL_ADMIN_PASSWORD=change-me-at-least-12-chars
ADMIN_IP_ALLOWLIST=
TRUSTED_PROXY_CIDRS=
REPORT_THRESHOLD_DEFAULT=5
LOG_LEVEL=INFO
